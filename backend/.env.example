# Exportar estas variables en la terminal o configurarlas en el IDE.
# Spring Boot no carga .env automáticamente.
# PostgreSQL es el perfil predeterminado.
DB_URL=jdbc:postgresql://localhost:5432/lys
DB_USERNAME=postgres
DB_PASSWORD=
# Generar un secreto aleatorio de al menos 32 bytes (ver README).
JWT_SECRET=
ADMIN_CORREO=admin@lys.pe
ADMIN_CLAVE=
# Cargo fijo por delivery, de 0 a 1000, con hasta dos decimales.
DELIVERY_COST=6.00
# Pruebas: base independiente; cada ejecución usa un esquema temporal propio.
TEST_DB_URL=jdbc:postgresql://localhost:5432/lys_test
TEST_DB_USERNAME=postgres
TEST_DB_PASSWORD=
