                  "pm.test('Incluye productos, combos y promociones', function () { const c=pm.response.json(); pm.expect(c.productos).to.be.an('array').that.is.not.empty; pm.expect(c.combos).to.be.an('array').that.is.not.empty; pm.expect(c.promociones).to.be.an('array').that.is.not.empty; });"
