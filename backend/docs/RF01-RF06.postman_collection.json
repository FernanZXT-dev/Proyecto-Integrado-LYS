{
  "info": {
    "name": "Pollería LYS — RF01 a RF06",
    "description": "Avance de backend PostgreSQL. Configurar credenciales en las variables y ejecutar en orden. Crea datos de demostración. No incluir contraseñas o tokens al compartir una exportación.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "adminCorreo",
      "value": "admin@lys.pe"
    },
    {
      "key": "adminClave",
      "value": ""
    },
    {
      "key": "clienteClave",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Acceso — configurar adminCorreo, adminClave y clienteClave",
      "item": [
        {
          "name": "Iniciar sesión de administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login/personal",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{adminCorreo}}\",\n  \"clave\": \"{{adminClave}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('adminClave') || !pm.collectionVariables.get('clienteClave')) throw new Error('Configurar adminClave y clienteClave en las variables de la colección antes de ejecutarla.');",
                  "const sufijo = Date.now().toString() + Math.floor(Math.random() * 10000).toString();",
                  "pm.collectionVariables.set('sufijo', sufijo);",
                  "pm.collectionVariables.set('clienteCorreo', 'demo-' + sufijo + '@example.test');",
                  "pm.collectionVariables.set('inicioPromo', new Date(Date.now() - 3600000).toISOString());",
                  "pm.collectionVariables.set('finPromo', new Date(Date.now() + 3600000).toISOString());",
                  "['adminToken','clienteToken','categoriaId','productoId','bebidaId','comboId','promocionId','pedidoLocalId','pedidoRecojoId','pedidoDeliveryId'].forEach(k => pm.collectionVariables.unset(k));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) pm.collectionVariables.set('adminToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar cliente de demostración",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/registro",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Cliente demostración\",\n  \"correo\": \"{{clienteCorreo}}\",\n  \"clave\": \"{{clienteClave}}\",\n  \"telefono\": \"999888777\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Iniciar sesión de cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login/cliente",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{clienteCorreo}}\",\n  \"clave\": \"{{clienteClave}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) pm.collectionVariables.set('clienteToken', pm.response.json().token);"
                ]
              }
            }
          ]
        }
      ]
    },
